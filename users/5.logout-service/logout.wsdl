<?xml version="1.0" encoding="UTF-8"?>
<definitions name="LogoutService"
  targetNamespace="http://www.globalenrollment.com/logout"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:tns="http://www.globalenrollment.com/logout"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <message name="logoutRequest">
    <part name="username" type="xsd:string"/>
  </message>

  <message name="logoutResponse">
    <part name="message" type="xsd:string"/>
  </message>

  <portType name="LogoutPortType">
    <operation name="logoutUser">
      <input message="tns:logoutRequest"/>
      <output message="tns:logoutResponse"/>
    </operation>
  </portType>

  <binding name="LogoutBinding" type="tns:LogoutPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="logoutUser">
      <soap:operation soapAction="logoutUser"/>
      <input>
        <soap:body use="literal" namespace="http://www.globalenrollment.com/logout"/>
      </input>
      <output>
        <soap:body use="literal" namespace="http://www.globalenrollment.com/logout"/>
      </output>
    </operation>
  </binding>

  <service name="LogoutService">
    <documentation>Servicio para cerrar sesión de usuario</documentation>
    <port name="LogoutPort" binding="tns:LogoutBinding">
      <soap:address location="http://localhost:3001/logout"/>
    </port>
  </service>
</definitions>
